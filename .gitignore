# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# LangGraph checkpoint（sqlite 二进制大文件，回滚成稿不需要它）
.checkpoints.sqlite

# 运行时状态（任务队列 / 会话登记 / 心跳，只在本机有意义）
service/tasks.json
service/heartbeat.json
sessions.json

# 过程留痕（LLM 思考记录，随文章公开的是 article.md）
output/**/thinking.md
output/thinking_ab/

# 素材库里的版权物（书籍 PDF 等，不分发）
corpus/*.pdf

# 兜底：任何密钥文件都不入库
.env
.env.*
!.env.example

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
